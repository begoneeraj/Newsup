# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore). See src/secrets_check.py for the vars that
# are enforced as required at pipeline startup.

# --- Required (checked by src/secrets_check.py at startup) ---
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
NEWSDATA_API_KEY=
MEDIASTACK_API_KEY=

# --- Optional ---
DATA_GOV_IN_API_KEY=
YOUTUBE_API_KEY=
API_SHARED_SECRET=

# Production source rights gate. Set production before public distribution,
# and list ONLY sources reviewed for the actual intended use and plan.
# No default production approvals are implied by keys or working RSS URLs.
NEWS_DEPLOYMENT_MODE=development
NEWS_SOURCE_ALLOWLIST=

# Current free Mediastack listing: 100 calls/month, non-commercial use.
# Set to the quota on YOUR account; this is not a licence grant.
MEDIASTACK_MONTHLY_LIMIT=100
GUARDIAN_DAILY_LIMIT=400
THE_GUARDIAN_API_KEY=
