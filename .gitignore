.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
.idea/
*.iml
.vscode/
pubspec.lock

# Python pipeline (src/)
__pycache__/
*.pyc
.venv/
.env

# Local tool state
.claude/
supabase/.temp/

# Firebase Admin SDK service-account keys — never commit, these are
# long-lived private keys used only by the Supabase Edge Function (set via
# `supabase secrets set`). google-services.json (Android client config, in
# android/app/) is not secret and is tracked normally.
*firebase-adminsdk*.json
newsup-db01f-*.json

# Fake news classifier training data (download from Kaggle yourself, see
# src/ml/fake_news_classifier.py) and the trained model it produces — all
# are build artifacts / third-party data, not source.
data/isot/*.csv
data/textdb3/*.csv
data/mrisdal/*.csv
src/ml/*.pkl

# Release signing — the keystore and its passwords are secrets, never commit.
# CI pulls them from GitHub Actions secrets instead (see release-apk.yml).
android/app/*.jks
android/key.properties

# Generated store packages; keep listing copy and branding assets tracked.
release/play-store/*.aab
release/play-store/*.apk
